# URL base da API do Catalogo Pro usada para buscar os produtos
VITE_API_URL=http://localhost:5000/api

# Configuração do Keycloak (autenticação)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=example-realm
VITE_KEYCLOAK_CLIENT_ID=example-client-id
# Client no Keycloak onde as roles de autorização (admin/user) estão definidas
VITE_KEYCLOAK_API_CLIENT_ID=example-api-client-id
